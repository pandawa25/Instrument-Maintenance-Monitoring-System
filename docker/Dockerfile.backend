# ===== Base =====
FROM node:20-alpine AS base
WORKDIR /app
# Prisma engine butuh OpenSSL, tapi base image node:20-alpine tidak menyertakannya —
# tanpa ini, Prisma gagal load engine ("Error: Could not parse schema engine response").
RUN apk add --no-cache openssl
RUN corepack enable

# ===== Dependencies =====
FROM base AS deps
COPY package.json package-lock.json* ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY packages/shared-types/package.json ./packages/shared-types/package.json
COPY packages/shared-utils/package.json ./packages/shared-utils/package.json
RUN npm install --workspace=apps/backend --workspace=packages/shared-types --workspace=packages/shared-utils

# ===== Build =====
FROM deps AS build
COPY packages ./packages
COPY apps/backend ./apps/backend
RUN npm run prisma:generate --workspace=apps/backend
RUN npm run build --workspace=apps/backend
# Diagnostic — pastikan dist/main.js benar-benar ada sebelum lanjut ke stage runtime.
# Kalau baris ini gagal, build logs akan langsung tunjukkan isi folder dist yang sebenarnya.
RUN ls -la apps/backend/dist && test -f apps/backend/dist/main.js

# ===== Runtime =====
FROM node:20-alpine AS runtime
WORKDIR /app
# Runtime adalah base image baru (bukan lanjutan dari stage build), jadi OpenSSL
# harus diinstall lagi di sini juga — dipakai saat `prisma db push` jalan di CMD.
RUN apk add --no-cache openssl
ENV NODE_ENV=production
# npm workspaces meng-hoist semua dependency ke node_modules di ROOT repo,
# bukan ke apps/backend/node_modules — copy dari sana, bukan dari path per-workspace.
COPY --from=build /app/node_modules ./node_modules
COPY --from=build /app/apps/backend/dist ./dist
COPY --from=build /app/apps/backend/prisma ./prisma
COPY --from=build /app/apps/backend/package.json ./package.json

EXPOSE 3000
# CATATAN SEMENTARA: memakai `db push` (bukan `migrate deploy`) karena belum ada
# file migration formal di prisma/migrations/ (belum sempat digenerate — environment
# development terblokir akses ke binaries.prisma.sh). `db push` menyamakan skema DB
# langsung ke schema.prisma tanpa riwayat migration, cukup untuk tahap MVP.
# TODO: begitu ada akses lokal penuh, jalankan `prisma migrate dev --name init`,
# commit folder prisma/migrations/ yang dihasilkan, lalu ganti baris di bawah ini
# kembali ke `prisma migrate deploy` supaya history migration production tercatat rapi.
CMD ["sh", "-c", "npx prisma db push --skip-generate --accept-data-loss --schema=./prisma/schema.prisma && node dist/main.js"]
