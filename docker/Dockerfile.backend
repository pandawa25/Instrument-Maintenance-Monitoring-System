# ===== Base =====
FROM node:20-alpine AS base
WORKDIR /app
# Prisma engine butuh OpenSSL, tapi base image node:20-alpine tidak menyertakannya —
# tanpa ini, Prisma gagal load engine ("Error: Could not parse schema engine response").
RUN apk add --no-cache openssl
RUN corepack enable

# ===== Dependencies =====
FROM base AS deps
COPY package.json package-lock.json* ./
COPY apps/backend/package.json ./apps/backend/package.json
COPY packages/shared-types/package.json ./packages/shared-types/package.json
COPY packages/shared-utils/package.json ./packages/shared-utils/package.json
RUN npm install --workspace=apps/backend --workspace=packages/shared-types --workspace=packages/shared-utils

# ===== Build =====
FROM deps AS build
COPY packages ./packages
COPY apps/backend ./apps/backend
RUN npm run prisma:generate --workspace=apps/backend
# shared-utils dikonsumsi backend sebagai compiled package (dist/ + .d.ts), bukan raw TS —
# rootDir backend (./src) tidak mengizinkan tsc meng-compile file .ts di luar apps/backend/src,
# jadi shared-utils harus di-build lebih dulu supaya backend hanya melihat .js + .d.ts-nya
# lewat resolusi node_modules biasa (symlink npm workspaces), bukan lewat path-mapping ke source.
RUN npm run build --workspace=packages/shared-utils
RUN npm run build --workspace=apps/backend
# Diagnostic — pastikan dist/main.js benar-benar ada sebelum lanjut ke stage runtime.
# Kalau baris ini gagal, build logs akan langsung tunjukkan isi folder dist yang sebenarnya.
RUN ls -la apps/backend/dist && test -f apps/backend/dist/main.js
# Compile prisma/seed.ts terpisah (bukan lewat ts-node, yang notabene devDependency
# dan tidak ikut ke image production) — file ini murni PrismaClient + bcrypt, tanpa
# decorator NestJS, jadi aman dikompilasi standalone dan dijalankan manual di Railway
# (Settings -> Deploy -> Custom Start Command) untuk seeding data awal:
#   node seed.js && node dist/main.js
RUN npx tsc apps/backend/prisma/seed.ts \
      --outDir apps/backend/dist-seed \
      --module commonjs --target es2021 --moduleResolution node \
      --esModuleInterop --skipLibCheck --resolveJsonModule

# ===== Runtime =====
FROM node:20-alpine AS runtime
WORKDIR /app
# Runtime adalah base image baru (bukan lanjutan dari stage build), jadi OpenSSL
# harus diinstall lagi di sini juga — dipakai saat `prisma migrate deploy` jalan di CMD.
RUN apk add --no-cache openssl
ENV NODE_ENV=production
# npm workspaces meng-hoist semua dependency ke node_modules di ROOT repo,
# bukan ke apps/backend/node_modules — copy dari sana, bukan dari path per-workspace.
# --chown=node:node di tiap COPY (bukan satu RUN chown -R di akhir) supaya tidak
# nge-copy layer cache raksasa (node_modules) dua kali hanya untuk ganti owner.
COPY --from=build --chown=node:node /app/node_modules ./node_modules
# node_modules/@imms/shared-utils adalah SYMLINK npm workspace ke ../../packages/shared-utils
# (relatif terhadap /app) — tanpa baris ini symlink-nya putus di runtime image dan container
# gagal start dengan "Cannot find module '@imms/shared-utils'". Cukup dist/ + package.json,
# tidak perlu source .ts-nya.
COPY --from=build --chown=node:node /app/packages/shared-utils/dist ./packages/shared-utils/dist
COPY --from=build --chown=node:node /app/packages/shared-utils/package.json ./packages/shared-utils/package.json
COPY --from=build --chown=node:node /app/apps/backend/dist ./dist
COPY --from=build --chown=node:node /app/apps/backend/prisma ./prisma
COPY --from=build --chown=node:node /app/apps/backend/package.json ./package.json
COPY --from=build --chown=node:node /app/apps/backend/dist-seed/seed.js ./seed.js
# Siapkan KEDUA kemungkinan lokasi UPLOAD_DIR (lihat config/app.config.ts) dan
# chown ke `node` di level IMAGE (sebelum Volume di-mount) — Docker/Railway
# meng-copy ownership+isi folder ini dari image ke Volume baru yang masih kosong
# saat pertama kali di-mount, jadi Volume ikut kebagian ownership `node` juga.
# Tanpa ini, Volume baru default dimiliki root dan container gagal start dengan
# EACCES begitu backend coba nulis file lampiran pertamanya.
RUN mkdir -p uploads /data/uploads && chown -R node:node uploads /data/uploads

# node:20-alpine sudah menyediakan user `node` (uid 1000) bawaan — jalan sebagai
# non-root di runtime mengecilkan blast radius kalau suatu saat ada RCE/dependency
# vulnerability.
USER node

EXPOSE 3000
# Technical Debt Risk #9: tanpa HEALTHCHECK, Railway cuma tahu container "crash"
# total (proses Node mati) — container yang hidup tapi stuck (mis. connection
# pool ke Postgres habis/deadlock, event loop macet) tidak pernah di-restart
# otomatis karena proses induknya tetap jalan. --start-period=30s kasih waktu
# untuk `prisma migrate deploy` selesai dulu sebelum healthcheck pertama mulai
# dihitung gagal. wget dipakai (bukan curl) karena sudah tersedia bawaan di
# base image alpine (busybox) — tidak perlu install dependency tambahan.
HEALTHCHECK --interval=30s --timeout=5s --start-period=30s --retries=3 \
  CMD wget --no-verbose --tries=1 --spider "http://127.0.0.1:${PORT:-3000}/api/health" || exit 1
# `migrate deploy` menjalankan migration formal dari prisma/migrations/ secara
# berurutan (bukan `db push` yang menyamakan skema paksa tanpa riwayat) — setiap
# perubahan schema sejak 3 Okt 2026 tercatat sebagai file migration ter-review,
# bisa di-rollback terarah, dan production sudah di-baseline ke 14 migration yang
# ada di folder ini (lihat docs/procedures/migrate-to-prisma-migrate-deploy.md).
CMD ["sh", "-c", "npx prisma migrate deploy --schema=./prisma/schema.prisma && node dist/main.js"]
