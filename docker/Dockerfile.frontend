# ===== Base =====
FROM node:20-alpine AS base
WORKDIR /app
RUN corepack enable

# ===== Dependencies =====
FROM base AS deps
COPY package.json package-lock.json* ./
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY packages/shared-types/package.json ./packages/shared-types/package.json
RUN npm install --workspace=apps/frontend --workspace=packages/shared-types

# ===== Build =====
FROM deps AS build
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
COPY packages/shared-types ./packages/shared-types
COPY apps/frontend ./apps/frontend
RUN npm run build --workspace=apps/frontend

# ===== Runtime (static via nginx) =====
# Varian "-unprivileged" (bukan image nginx biasa) — sudah dikonfigurasi upstream
# untuk jalan sebagai user non-root (uid 101) dari awal tanpa perlu `USER`/chown
# manual: /etc/nginx, /var/cache/nginx, dan port default-nya (8080, bukan 80)
# semua sudah dimiliki user tersebut. Master process nginx biasa WAJIB root untuk
# bind port <1024; image ini menghindarinya sepenuhnya.
FROM nginxinc/nginx-unprivileged:1.27-alpine AS runtime
# Railway (dan platform PaaS lain) assign port publik secara dinamis lewat env $PORT —
# container WAJIB listen di port itu, bukan port hardcoded, atau request dari edge
# proxy tidak akan sampai ("Application failed to respond" / 502). Default di bawah
# cuma fallback untuk `docker run` lokal tanpa $PORT; HARUS >1024 karena non-root.
# Taruh config di /etc/nginx/templates/*.template — entrypoint bawaan image nginx
# otomatis menjalankan envsubst untuk mengganti ${PORT} sebelum nginx start.
ENV PORT=8080
COPY docker/nginx.frontend.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/frontend/dist /usr/share/nginx/html

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]
