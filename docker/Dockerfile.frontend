# ===== Base =====
FROM node:20-alpine AS base
WORKDIR /app
RUN corepack enable

# ===== Dependencies =====
FROM base AS deps
COPY package.json package-lock.json* ./
COPY apps/frontend/package.json ./apps/frontend/package.json
COPY packages/shared-types/package.json ./packages/shared-types/package.json
RUN npm install --workspace=apps/frontend --workspace=packages/shared-types

# ===== Build =====
FROM deps AS build
ARG VITE_API_BASE_URL=/api
ENV VITE_API_BASE_URL=$VITE_API_BASE_URL
COPY packages/shared-types ./packages/shared-types
COPY apps/frontend ./apps/frontend
RUN npm run build --workspace=apps/frontend

# ===== Runtime (static via nginx) =====
FROM nginx:1.27-alpine AS runtime
# Railway (dan platform PaaS lain) assign port publik secara dinamis lewat env $PORT —
# container WAJIB listen di port itu, bukan port 80 hardcoded, atau request dari edge
# proxy tidak akan sampai ("Application failed to respond" / 502).
# Taruh config di /etc/nginx/templates/*.template — entrypoint bawaan image nginx
# otomatis menjalankan envsubst untuk mengganti ${PORT} sebelum nginx start.
ENV PORT=80
COPY docker/nginx.frontend.conf /etc/nginx/templates/default.conf.template
COPY --from=build /app/apps/frontend/dist /usr/share/nginx/html

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
