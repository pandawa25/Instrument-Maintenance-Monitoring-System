{
  "name": "instrument-maintenance-system",
  "private": true,
  "version": "0.1.0",
  "description": "Instrument Maintenance Monitoring System - monorepo",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build:shared-utils": "npm run build --workspace=packages/shared-utils",
    "predev:backend": "npm run build:shared-utils",
    "dev:backend": "npm run start:dev --workspace=apps/backend",
    "dev:frontend": "npm run dev --workspace=apps/frontend",
    "prebuild:backend": "npm run build:shared-utils",
    "build:backend": "npm run build --workspace=apps/backend",
    "build:frontend": "npm run build --workspace=apps/frontend",
    "build": "npm run build:backend && npm run build:frontend",
    "prisma:generate": "npm run prisma:generate --workspace=apps/backend",
    "prisma:migrate": "npm run prisma:migrate --workspace=apps/backend",
    "prisma:seed": "npm run prisma:seed --workspace=apps/backend",
    "lint": "npm run lint --workspace=apps/backend && npm run lint --workspace=apps/frontend"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
