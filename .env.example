# ---- Database ----
POSTGRES_USER=imms_user
POSTGRES_PASSWORD=change_me
POSTGRES_DB=imms_db
POSTGRES_PORT=5432
DATABASE_URL="postgresql://imms_user:change_me@localhost:5432/imms_db?schema=public"

# ---- Backend ----
PORT=3000
NODE_ENV=development
# WAJIB minimal 32 karakter saat NODE_ENV=production (aplikasi refuse boot kalau
# kurang/tidak di-set) — generate dengan: openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string_at_least_32_chars
JWT_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
# Origin frontend (scheme://host[:port], TANPA path). Boleh beberapa dipisah koma, mis. apex + www:
#   CORS_ORIGIN=https://tigalimabelas.com,https://www.tigalimabelas.com
#   Wildcard subdomain (apex ditulis terpisah): CORS_ORIGIN=https://tigalimabelas.com,https://*.tigalimabelas.com
# Wajib sama persis dengan alamat yang diketik di browser — ganti domain = WAJIB update ini.
CORS_ORIGIN=http://localhost:5173
# Jumlah proxy tepercaya di depan backend (default: 1 di production, 0 di lokal).
# Railway saja = 1; Railway + Cloudflare proxy (awan oranye) = 2. Salah isi -> rate limit
# login dihitung per IP proxy (semua user berbagi kuota) atau IP bisa dipalsukan.
# TRUST_PROXY=1
# Opsional: domain cookie refresh token, mis. .tigalimabelas.com (frontend & API beda subdomain).
# COOKIE_DOMAIN=
# Opsional: none | lax | strict. Kalau frontend & API satu site (tigalimabelas.com &
# api.tigalimabelas.com) disarankan "lax".
# COOKIE_SAMESITE=lax
# Kosongkan (default ikut NODE_ENV) di Railway — HTTPS otomatis di sana jadi
# cookie refresh token aman pakai Secure+SameSite=None. Set eksplisit "false"
# hanya kalau jalan di HTTP polos (mis. docker-compose lokal).
# COOKIE_SECURE=false
# Folder penyimpanan lampiran evidence (foto/PDF). Di Railway, set ke path
# yang sudah di-mount sebagai Volume (mis. /data/uploads) supaya persisten
# antar redeploy — tanpa Volume, file akan hilang tiap deploy baru.
UPLOAD_DIR=./uploads

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:3000/api
