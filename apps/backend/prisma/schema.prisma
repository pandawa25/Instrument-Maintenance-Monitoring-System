generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AreaStatus {
  ACTIVE
  INACTIVE
}

enum EquipmentStatus {
  ACTIVE
  STANDBY
  OUT_OF_SERVICE
}

enum Criticality {
  HIGH
  MEDIUM
  LOW
}

enum FailureCategory {
  INSTRUMENT
  ELECTRICAL
  MECHANICAL
  COMMUNICATION
  CONFIGURATION
  CALIBRATION
  PROCESS
}

enum MaintenanceStatus {
  OPEN
  IN_PROGRESS
  WAITING_MATERIAL // menunggu kedatangan spare part / material sebelum bisa lanjut
  COMPLETED
  CANCELLED // dibatalkan — bukan selesai & bukan dihapus (tetap tercatat utk histori)
}

// Posisi fail-safe aktuator saat kehilangan sinyal/power — hanya relevan untuk
// equipment valve (Control Valve, Solenoid Valve, On-Off Valve, On-Off Valve SIS).
// Lihat juga field size/rating/failAction di model Equipment.
enum FailAction {
  CLOSE
  OPEN
  LAST_POSITION
}

enum VendorStatus {
  ACTIVE
  INACTIVE
}

enum PmProgramStatus {
  ACTIVE
  INACTIVE
}

enum PmFrequencyUnit {
  DAY
  WEEK
  MONTH
  YEAR
}

enum PmExecutionResult {
  OK
  NOT_OK
}

enum PmChecklistResult {
  OK
  NOT_OK
  NA
}

enum PmExecutionStatus {
  PENDING
  COMPLETED
}

enum SparePartStatus {
  ACTIVE
  INACTIVE
}

enum StockMovementType {
  MAINTENANCE_USAGE // otomatis: dipakai di Corrective Maintenance (quantityDelta negatif)
  MAINTENANCE_RETURN // otomatis: dikembalikan krn Corrective Maintenance diedit/dihapus (quantityDelta positif)
  RESTOCK // manual: Admin tambah stock baru / "Stock In" (quantityDelta positif)
  STOCK_OUT // manual: Admin keluarkan stock di luar Corrective Maintenance — mis. dipakai langsung di lapangan tanpa tiket CM, rusak/scrap, dipindah ke project lain (quantityDelta negatif)
  ADJUSTMENT // manual: koreksi hasil stock opname (quantityDelta boleh +/-)
}

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  name        String    @unique @db.VarChar(50)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  users User[]

  @@map("roles")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique @db.VarChar(150)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  fullName     String    @map("full_name") @db.VarChar(150)
  roleId       String    @map("role_id") @db.Uuid
  isActive     Boolean   @default(true) @map("is_active")
  lastLoginAt  DateTime? @map("last_login_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")
  deletedAt    DateTime? @map("deleted_at")

  role               Role                    @relation(fields: [roleId], references: [id])
  maintenanceAsTech  CorrectiveMaintenance[] @relation("TechnicianMaintenance")
  maintenanceCreated CorrectiveMaintenance[] @relation("CreatedByMaintenance")
  importBatches      ImportBatch[]
  stockMovements     SparePartStockMovement[]
  attachments        Attachment[]
  refreshTokens      RefreshToken[]
  loginHistory       LoginHistory[]
  auditLogs          AuditLog[]
  maintenanceAsAdditionalTech CorrectiveMaintenanceTechnician[]

  @@index([roleId])
  @@map("users")
}

model Area {
  id          String     @id @default(uuid()) @db.Uuid
  areaCode    String     @unique @map("area_code") @db.VarChar(20)
  areaName    String     @map("area_name") @db.VarChar(150)
  description String?    @db.VarChar(255)
  status      AreaStatus @default(ACTIVE)
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")
  deletedAt   DateTime?  @map("deleted_at")

  equipment   Equipment[]
  maintenance CorrectiveMaintenance[]

  @@index([status])
  @@map("areas")
}

// Master data nama instrument (dulu "Instrument Type") — mis. Pressure Transmitter,
// Temperature Transmitter, dst. Dipakai sebagai relasi pada kolom "Instrument Name".
model InstrumentName {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(30)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  equipment Equipment[]

  @@map("instrument_names")
}

model Equipment {
  id               String          @id @default(uuid()) @db.Uuid
  // CATATAN PENTING soal uniqueness tag_number:
  // Tidak pakai @unique biasa di sini. Constraint sebenarnya adalah PARTIAL UNIQUE INDEX
  // case-insensitive yang hanya berlaku untuk baris aktif (deleted_at IS NULL), dibuat manual
  // lewat migration SQL (lihat migrations/20260928000100_equipment_tag_partial_unique) karena
  // Prisma schema tidak punya syntax untuk partial index. Ini sengaja: tag_number BOLEH dipakai
  // ulang setelah equipment lama di-soft-delete.
  // AKIBATNYA: field ini harus tetap TANPA @unique dan TANPA @@unique di schema ini selamanya.
  // Kalau nanti mengubah model Equipment dan menjalankan `prisma migrate dev`, WAJIB pakai
  // `--create-only` lalu review manual — migrate dev tidak tahu soal partial index ini dan bisa
  // mengusulkan DROP INDEX "equipment_tag_number_active_key". Jangan pernah terima diff itu.
  tagNumber        String          @map("tag_number") @db.VarChar(50)
  service          String          @db.VarChar(150)
  description      String?         @db.VarChar(255)
  areaId           String          @map("area_id") @db.Uuid
  instrumentNameId String          @map("instrument_name_id") @db.Uuid
  type             String?         @db.VarChar(100)
  manufacturer     String?         @db.VarChar(100)
  model            String?         @db.VarChar(100)
  serialNumber     String?         @map("serial_number") @db.VarChar(100)
  installationDate DateTime?       @map("installation_date") @db.Date
  // LRV/URV/Unit: hanya relevan untuk equipment pengukuran (transmitter/gauge dst).
  // Untuk equipment valve (kode instrument name CV/SV/KV/UV) field ini TIDAK dipakai —
  // dipakai size/rating/failAction di bawah (lihat VALVE_INSTRUMENT_CODES di frontend,
  // dan revisi "Module Equipment valve fields"). Keduanya sengaja tetap nullable &
  // tidak saling exclusive di level DB/DTO — UX show/hide-nya murni di frontend (MVP,
  // konsisten dengan pendekatan lrv/urv yang juga tidak divalidasi per instrument type).
  lrv              Decimal?        @db.Decimal(14, 4)
  urv              Decimal?        @db.Decimal(14, 4)
  unit             String?         @db.VarChar(20)
  // Size/Rating/FailAction: khusus equipment valve (CV/SV/KV/UV) — lihat catatan di atas.
  size             String?         @db.VarChar(50)
  rating           String?         @db.VarChar(50)
  failAction       FailAction?     @map("fail_action")
  status           EquipmentStatus @default(ACTIVE)
  criticality      Criticality     @default(MEDIUM)
  remarks          String?         @db.VarChar(500)
  // Batch bulk-upload yang membuat baris ini — nullable karena mayoritas equipment dibuat
  // manual lewat form, bukan dari import. Murni untuk penelusuran/audit ("equipment ini dari
  // upload mana"), tidak dipakai untuk validasi apa pun.
  importBatchId    String?         @map("import_batch_id") @db.Uuid
  createdAt        DateTime        @default(now()) @map("created_at")
  updatedAt        DateTime        @updatedAt @map("updated_at")
  deletedAt        DateTime?       @map("deleted_at")

  area           Area                    @relation(fields: [areaId], references: [id])
  instrumentName InstrumentName          @relation(fields: [instrumentNameId], references: [id])
  importBatch    ImportBatch?            @relation(fields: [importBatchId], references: [id])
  maintenance    CorrectiveMaintenance[]
  pmPrograms     PmProgramEquipment[]
  pmExecutions   PmPeriodExecution[]

  @@index([areaId])
  @@index([instrumentNameId])
  @@index([status])
  @@index([areaId, status])
  @@index([importBatchId])
  // Index biasa (bukan unique) supaya schema tidak "buta" soal index di kolom ini — lihat
  // catatan di field tagNumber. Uniqueness case-insensitive & partial ada di migration SQL.
  @@index([tagNumber])
  @@map("equipment")
}

// ================= Preventive Maintenance =================

model Vendor {
  id             String       @id @default(uuid()) @db.Uuid
  name           String       @db.VarChar(150)
  contactPerson  String?      @map("contact_person") @db.VarChar(100)
  phone          String?      @db.VarChar(30)
  email          String?      @db.VarChar(150)
  address        String?      @db.VarChar(255)
  status         VendorStatus @default(ACTIVE)
  remarks        String?      @db.VarChar(500)
  createdAt      DateTime     @default(now()) @map("created_at")
  updatedAt      DateTime     @updatedAt @map("updated_at")
  deletedAt      DateTime?    @map("deleted_at")

  pmPrograms PmProgram[]

  @@index([status])
  @@map("vendors")
}

// Master jenis aktifitas PM (Cleaning, Calibration, Drift Test, dll) — dipakai
// sebagai klasifikasi tiap checklist item pada PM Program.
model PmActivityType {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @unique @db.VarChar(20)
  name        String    @db.VarChar(100)
  description String?   @db.VarChar(255)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  checklistItems PmChecklistItem[]

  @@map("pm_activity_types")
}

// "Modul PM" yang dibuat Admin di frontend — mis. "PM ATG 3 Bulanan" oleh PT A.
model PmProgram {
  id              String           @id @default(uuid()) @db.Uuid
  name            String           @db.VarChar(150)
  frequencyValue  Int              @map("frequency_value")
  frequencyUnit   PmFrequencyUnit  @map("frequency_unit")
  vendorId        String           @map("vendor_id") @db.Uuid
  startDate       DateTime         @map("start_date") @db.Date
  status          PmProgramStatus  @default(ACTIVE)
  remarks         String?          @db.VarChar(500)
  createdAt       DateTime         @default(now()) @map("created_at")
  updatedAt       DateTime         @updatedAt @map("updated_at")
  deletedAt       DateTime?        @map("deleted_at")

  vendor         Vendor               @relation(fields: [vendorId], references: [id])
  equipment      PmProgramEquipment[]
  checklistItems PmChecklistItem[]
  periods        PmPeriod[]

  @@index([vendorId])
  @@index([status])
  @@map("pm_programs")
}

model PmProgramEquipment {
  id          String   @id @default(uuid()) @db.Uuid
  pmProgramId String   @map("pm_program_id") @db.Uuid
  equipmentId String   @map("equipment_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at")

  pmProgram PmProgram @relation(fields: [pmProgramId], references: [id], onDelete: Cascade)
  equipment Equipment @relation(fields: [equipmentId], references: [id])

  @@unique([pmProgramId, equipmentId])
  @@index([equipmentId])
  @@map("pm_program_equipment")
}

model PmChecklistItem {
  id             String    @id @default(uuid()) @db.Uuid
  pmProgramId    String    @map("pm_program_id") @db.Uuid
  activityTypeId String    @map("activity_type_id") @db.Uuid
  description    String?   @db.VarChar(255)
  sortOrder      Int       @default(0) @map("sort_order")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  deletedAt      DateTime? @map("deleted_at")

  pmProgram    PmProgram      @relation(fields: [pmProgramId], references: [id], onDelete: Cascade)
  activityType PmActivityType @relation(fields: [activityTypeId], references: [id])

  @@index([pmProgramId])
  @@map("pm_checklist_items")
}

// Satu siklus/iterasi PM dalam sebuah Program — "Periode 1", "Periode 2", dst.
model PmPeriod {
  id          String    @id @default(uuid()) @db.Uuid
  pmProgramId String    @map("pm_program_id") @db.Uuid
  periodNumber Int      @map("period_number")
  plannedDate DateTime  @map("planned_date") @db.Date
  remarks     String?   @db.VarChar(500)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  pmProgram  PmProgram           @relation(fields: [pmProgramId], references: [id], onDelete: Cascade)
  executions PmPeriodExecution[]

  @@unique([pmProgramId, periodNumber])
  @@index([plannedDate])
  @@map("pm_periods")
}

// Hasil eksekusi PM untuk 1 equipment dalam 1 Periode.
model PmPeriodExecution {
  id              String             @id @default(uuid()) @db.Uuid
  pmPeriodId      String             @map("pm_period_id") @db.Uuid
  equipmentId     String             @map("equipment_id") @db.Uuid
  executionDate   DateTime?          @map("execution_date") @db.Date
  result          PmExecutionResult?
  findings        String?            @db.VarChar(1000)
  actionTaken     String?            @map("action_taken") @db.VarChar(1000)
  vendorPersonnel String?            @map("vendor_personnel") @db.VarChar(150)
  status          PmExecutionStatus  @default(PENDING)
  remarks         String?            @db.VarChar(500)
  // Referensi Work Order dari ERP (mis. SAP PM) — dicatat manual setelah WO
  // diterbitkan di sana, bukan dikelola sebagai workflow WO internal aplikasi
  // ini. Semua nullable & free-text karena bisa diisi belakangan dan format
  // status WO bervariasi antar ERP.
  workOrderNumber String?            @map("work_order_number") @db.VarChar(50)
  workOrderDate   DateTime?          @map("work_order_date") @db.Date
  workOrderStatus String?            @map("work_order_status") @db.VarChar(50)
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")
  deletedAt       DateTime?          @map("deleted_at")

  pmPeriod         PmPeriod                      @relation(fields: [pmPeriodId], references: [id], onDelete: Cascade)
  equipment        Equipment                     @relation(fields: [equipmentId], references: [id])
  checklistResults PmExecutionChecklistResult[]

  @@unique([pmPeriodId, equipmentId])
  @@index([equipmentId])
  @@index([status])
  @@map("pm_period_executions")
}

// Snapshot hasil per checklist item saat eksekusi — nama activity type & deskripsi
// disalin (bukan hanya FK) supaya histori tidak berubah kalau master diedit belakangan.
model PmExecutionChecklistResult {
  id                  String             @id @default(uuid()) @db.Uuid
  pmPeriodExecutionId String             @map("pm_period_execution_id") @db.Uuid
  activityTypeName    String             @map("activity_type_name") @db.VarChar(100)
  description         String?            @db.VarChar(255)
  result              PmChecklistResult  @default(NA)
  notes               String?            @db.VarChar(500)
  sortOrder           Int                @default(0) @map("sort_order")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  pmPeriodExecution PmPeriodExecution @relation(fields: [pmPeriodExecutionId], references: [id], onDelete: Cascade)

  @@index([pmPeriodExecutionId])
  @@map("pm_execution_checklist_results")
}

model CorrectiveMaintenance {
  id                 String            @id @default(uuid()) @db.Uuid
  // Nomor e-SPK (e-Surat Perintah Kerja) — diisi MANUAL oleh user, diambil dari aplikasi
  // e-SPK eksternal (bukan di-generate oleh sistem ini). Wajib & unik supaya tiap pekerjaan
  // tetap punya 1 identitas yang bisa ditelusuri balik ke sistem e-SPK sumbernya.
  // Ini BUKAN field yang sama dengan workOrderNumber di bawah (itu referensi WO dari ERP/SAP PM,
  // juga manual & terpisah — keduanya referensi ke sistem eksternal yang berbeda).
  spkNumber          String            @unique @map("spk_number") @db.VarChar(50)
  maintenanceDate    DateTime          @map("maintenance_date") @db.Date
  equipmentId        String            @map("equipment_id") @db.Uuid
  areaId             String            @map("area_id") @db.Uuid
  failureCategory    FailureCategory   @map("failure_category")
  problemDescription String            @map("problem_description") @db.VarChar(1000)
  rootCause          String?           @map("root_cause") @db.VarChar(1000)
  actionTaken        String?           @map("action_taken") @db.VarChar(1000)
  downtimeHours      Decimal?          @map("downtime_hours") @db.Decimal(6, 2)
  technicianId       String            @map("technician_id") @db.Uuid
  // Reuse enum Criticality (HIGH/MEDIUM/LOW) yang sudah dipakai di Equipment — skala yang sama,
  // tidak perlu enum terpisah.
  priority           Criticality       @default(MEDIUM)
  status             MaintenanceStatus @default(OPEN)
  completionDate     DateTime?         @map("completion_date") @db.Date
  needsSparePart     Boolean           @default(false) @map("needs_spare_part")
  createdById        String            @map("created_by_id") @db.Uuid
  remarks            String?           @db.VarChar(500)
  // Referensi Notifikasi & Work Order dari ERP (mis. SAP PM) — dicatat manual
  // setelah diterbitkan di sana, bukan dikelola sebagai workflow internal
  // aplikasi ini. Semua nullable & free-text (status WO/notifikasi bervariasi
  // antar ERP, jadi tidak dipaksakan jadi enum).
  notificationNumber String?           @map("notification_number") @db.VarChar(50)
  notificationDate   DateTime?         @map("notification_date") @db.Date
  notificationStatus String?           @map("notification_status") @db.VarChar(50)
  workOrderNumber    String?           @map("work_order_number") @db.VarChar(50)
  workOrderDate      DateTime?         @map("work_order_date") @db.Date
  workOrderStatus    String?           @map("work_order_status") @db.VarChar(50)
  createdAt          DateTime          @default(now()) @map("created_at")
  updatedAt          DateTime          @updatedAt @map("updated_at")
  deletedAt          DateTime?         @map("deleted_at")

  equipment            Equipment  @relation(fields: [equipmentId], references: [id])
  area                 Area       @relation(fields: [areaId], references: [id])
  technician           User       @relation("TechnicianMaintenance", fields: [technicianId], references: [id])
  createdBy            User       @relation("CreatedByMaintenance", fields: [createdById], references: [id])
  materials            CorrectiveMaintenanceMaterial[]
  additionalTechnicians CorrectiveMaintenanceTechnician[]

  @@index([maintenanceDate])
  @@index([equipmentId])
  @@index([areaId])
  @@index([status])
  @@index([priority])
  @@index([areaId, maintenanceDate])
  @@map("corrective_maintenance")
}

// Master Spare Part / Material — "kimap" adalah nama field untuk kode/nomor part
// sesuai istilah yang dipakai user (bukan "Part Number" generik).
model SparePart {
  id        String          @id @default(uuid()) @db.Uuid
  kimap     String          @unique @db.VarChar(50)
  name      String          @db.VarChar(150)
  unit      String          @db.VarChar(20)
  stock     Int             @default(0)
  // Ambang batas "low stock" untuk Inventory Dashboard — default 0 berarti baru
  // ditandai low stock kalau stock sudah habis (non-breaking untuk data lama).
  // Diisi manual per item oleh Admin sesuai kebutuhan reorder masing-masing part.
  minStock  Int             @default(0) @map("min_stock")
  status    SparePartStatus @default(ACTIVE)
  remarks   String?         @db.VarChar(500)
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")
  deletedAt DateTime?       @map("deleted_at")

  materials CorrectiveMaintenanceMaterial[]
  stockMovements SparePartStockMovement[]

  @@index([status])
  @@map("spare_parts")
}

// Ledger pergerakan stock — sumber kebenaran histori, `SparePart.stock` adalah
// cached balance hasil movement terakhir (supaya list/dropdown tetap cepat
// tanpa perlu SUM tiap request). Setiap perubahan stock WAJIB lewat sini
// (SparePartsRepository.recordMovement), tidak boleh update stock langsung.
model SparePartStockMovement {
  id            String            @id @default(uuid()) @db.Uuid
  sparePartId   String            @map("spare_part_id") @db.Uuid
  type          StockMovementType
  quantityDelta Int               @map("quantity_delta")
  balanceAfter  Int               @map("balance_after")
  referenceType String?           @map("reference_type") @db.VarChar(50)
  referenceId   String?           @map("reference_id") @db.Uuid
  notes         String?           @db.VarChar(255)
  createdById   String            @map("created_by_id") @db.Uuid
  createdAt     DateTime          @default(now()) @map("created_at")

  sparePart SparePart @relation(fields: [sparePartId], references: [id])
  createdBy User      @relation(fields: [createdById], references: [id])

  @@index([sparePartId])
  @@index([referenceType, referenceId])
  @@map("spare_part_stock_movements")
}

// Baris kebutuhan material pada satu Corrective Maintenance (MVP: cukup daftar
// kebutuhan, tanpa tracking status pemenuhan per item — lihat design-document.md).
model CorrectiveMaintenanceMaterial {
  id                     String   @id @default(uuid()) @db.Uuid
  correctiveMaintenanceId String  @map("corrective_maintenance_id") @db.Uuid
  sparePartId            String   @map("spare_part_id") @db.Uuid
  quantity               Decimal  @db.Decimal(10, 2)
  remarks                String?  @db.VarChar(255)
  createdAt              DateTime @default(now()) @map("created_at")

  correctiveMaintenance CorrectiveMaintenance @relation(fields: [correctiveMaintenanceId], references: [id], onDelete: Cascade)
  sparePart             SparePart             @relation(fields: [sparePartId], references: [id])

  @@index([correctiveMaintenanceId])
  @@index([sparePartId])
  @@map("corrective_maintenance_materials")
}

// Technician TAMBAHAN (anggota tim) selain `technician` utama di
// CorrectiveMaintenance — technician utama tidak dipindah ke sini supaya
// tidak breaking (laporan/filter existing yang pakai technicianId tetap
// jalan apa adanya). Tabel ini murni untuk kasus butuh >1 orang.
model CorrectiveMaintenanceTechnician {
  id                      String   @id @default(uuid()) @db.Uuid
  correctiveMaintenanceId String   @map("corrective_maintenance_id") @db.Uuid
  userId                  String   @map("user_id") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at")

  correctiveMaintenance CorrectiveMaintenance @relation(fields: [correctiveMaintenanceId], references: [id], onDelete: Cascade)
  user                  User                  @relation(fields: [userId], references: [id])

  @@unique([correctiveMaintenanceId, userId])
  @@index([userId])
  @@map("corrective_maintenance_technicians")
}

// ===== Bulk Import (mulai dari Module Equipment; entityType siap dipakai modul lain nanti) =====

enum ImportEntityType {
  EQUIPMENT
}

enum ImportMode {
  CREATE_ONLY
}

enum ImportBatchStatus {
  VALIDATED // hasil preview siap dilihat user; boleh masih ada baris ERROR (commit akan ditolak selama itu)
  COMMITTED // sudah berhasil disimpan ke tabel entitasnya (mis. equipment)
  FAILED // commit dicoba tapi gagal (mis. race condition tag/kode berubah di antara preview & commit)
  EXPIRED // preview kedaluwarsa (lihat expiresAt), tidak bisa di-commit lagi — harus preview ulang
}

enum ImportRowSeverity {
  OK
  WARNING
  ERROR
}

model ImportBatch {
  id           String            @id @default(uuid()) @db.Uuid
  entityType   ImportEntityType  @map("entity_type")
  mode         ImportMode        @default(CREATE_ONLY)
  filename     String            @db.VarChar(255)
  // SHA-256 file. CATATAN: uniqueness-nya BUKAN @@unique biasa (lihat bawah) — harus partial
  // (hanya untuk status COMMITTED), supaya user tetap boleh preview ulang file yang sama
  // berkali-kali sebelum commit. Pola sama seperti tagNumber di Equipment: constraint asli
  // ada di migration SQL manual, bukan di schema ini.
  fileChecksum String            @map("file_checksum") @db.VarChar(64)
  status       ImportBatchStatus @default(VALIDATED)
  totalRows    Int               @map("total_rows")
  okRows       Int               @map("ok_rows")
  warningRows  Int               @map("warning_rows")
  errorRows    Int               @map("error_rows")
  createdById  String            @map("created_by_id") @db.Uuid
  committedAt  DateTime?         @map("committed_at")
  // Batas waktu preview ini masih boleh di-commit — lihat catatan EXPIRED di atas.
  expiresAt    DateTime          @map("expires_at")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @updatedAt @map("updated_at")
  deletedAt    DateTime?         @map("deleted_at")

  createdBy User             @relation(fields: [createdById], references: [id])
  rows      ImportBatchRow[]
  equipment Equipment[]

  // Index biasa supaya schema tidak "buta" soal index di kolom ini — uniqueness sebenarnya
  // (partial, hanya WHERE status = 'COMMITTED') ada di migration SQL manual. Kalau nanti
  // menjalankan `prisma migrate dev` setelah mengubah model ini, WAJIB --create-only + review
  // manual, sama seperti catatan di field Equipment.tagNumber.
  @@index([entityType, fileChecksum])
  @@index([status])
  @@index([createdById])
  @@map("import_batches")
}

model ImportBatchRow {
  id        String            @id @default(uuid()) @db.Uuid
  batchId   String            @map("batch_id") @db.Uuid
  rowNumber Int               @map("row_number")
  // Nilai mentah dari Excel + nilai yang sudah di-resolve (areaId, instrumentNameId, dst)
  // supaya commit tidak perlu parse ulang Excel-nya.
  payload   Json
  severity  ImportRowSeverity
  // Daftar pesan validasi untuk baris ini (bisa lebih dari satu WARNING sekaligus, atau
  // berhenti di ERROR pertama — lihat EquipmentImportService).
  messages  Json
  createdAt DateTime          @default(now()) @map("created_at")
  updatedAt DateTime          @updatedAt @map("updated_at")
  deletedAt DateTime?         @map("deleted_at")

  batch ImportBatch @relation(fields: [batchId], references: [id])

  @@unique([batchId, rowNumber])
  @@index([batchId, severity])
  @@map("import_batch_rows")
}

// Entity yang boleh punya lampiran evidence — tambah value baru di sini kalau ada
// modul lain yang butuh attachment nanti (polymorphic, bukan FK terpisah per modul).
enum AttachmentEntityType {
  CORRECTIVE_MAINTENANCE
  PM_PERIOD_EXECUTION
}

// Lampiran foto/dokumen evidence (bukti pengerjaan) untuk Corrective Maintenance
// & PM Period Execution. File fisik disimpan di Railway Volume (disk lokal,
// lihat UPLOAD_DIR di app.config.ts) — tabel ini hanya menyimpan metadata +
// path relatif. Tidak ada FK langsung ke corrective_maintenance/pm_period_executions
// (polymorphic by design) — validasi entity ada di AttachmentsService.
model Attachment {
  id           String               @id @default(uuid()) @db.Uuid
  entityType   AttachmentEntityType @map("entity_type")
  entityId     String               @map("entity_id") @db.Uuid
  fileName     String               @map("file_name") @db.VarChar(255)
  // Path relatif terhadap UPLOAD_DIR, mis. "2026/09/<uuid>.jpg" — bukan nama asli,
  // supaya tidak ada risiko collision/path traversal dari nama file upload user.
  storedPath   String               @map("stored_path") @db.VarChar(255)
  mimeType     String               @map("mime_type") @db.VarChar(100)
  fileSize     Int                  @map("file_size")
  uploadedById String               @map("uploaded_by_id") @db.Uuid
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  deletedAt    DateTime?            @map("deleted_at")

  uploadedBy User @relation(fields: [uploadedById], references: [id])

  @@index([entityType, entityId])
  @@map("attachments")
}

// Refresh token opaque (bukan JWT) — token mentah cuma dikirim sekali ke
// client lewat httpOnly cookie, yang disimpan di sini SELALU hash SHA-256-nya
// (sama seperti prinsip password hashing: kalau DB bocor, token tidak
// langsung bisa dipakai). Rotation: setiap dipakai di POST /auth/refresh,
// token ini di-revoke dan digantikan token baru (replacedById) — reuse
// terhadap token yang sudah di-revoke dianggap tanda pencurian, memicu
// revoke SEMUA refresh token milik user itu (lihat AuthService.refresh()).
model RefreshToken {
  id           String    @id @default(uuid()) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  tokenHash    String    @unique @map("token_hash") @db.VarChar(64)
  expiresAt    DateTime  @map("expires_at")
  revokedAt    DateTime? @map("revoked_at")
  replacedById String?   @map("replaced_by_id") @db.Uuid
  userAgent    String?   @map("user_agent") @db.VarChar(255)
  ipAddress    String?   @map("ip_address") @db.VarChar(45)
  createdAt    DateTime  @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("refresh_tokens")
}

// Audit percobaan login — sukses maupun gagal, TAPI hanya untuk email yang
// benar-benar terdaftar (menghindari noise dari email asal ketik/bot scan).
// Berguna untuk deteksi percobaan brute-force pada 1 akun.
model LoginHistory {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  success   Boolean
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([userId])
  @@map("login_history")
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
}

// Jejak audit terpusat untuk semua mutasi (create/update/delete) di modul
// master data & transaksi — dicatat otomatis lewat AuditLogInterceptor
// (global), diaktifkan per endpoint lewat decorator @AuditLog('EntityName').
//
// `payload` = snapshot request body (data yang DIKIRIM user), BUKAN
// before/after diff — cukup untuk jejak "siapa mengubah apa kapan" tanpa
// menambah query baca sebelum tiap mutasi (MVP, lihat README bagian Audit
// Log Terpusat). Field sensitif (password, token, dst) di-redact sebelum
// disimpan — lihat common/utils/redact-sensitive.util.ts.
//
// SENGAJA TIDAK PAKAI pola updated_at/deleted_at standar tabel lain — log
// audit bersifat append-only/immutable, tidak pernah diupdate atau di-soft-
// delete (itu justru akan merusak tujuan audit trail itu sendiri).
model AuditLog {
  id         String      @id @default(uuid()) @db.Uuid
  userId     String      @map("user_id") @db.Uuid
  action     AuditAction
  entityType String      @map("entity_type") @db.VarChar(50)
  entityId   String?     @map("entity_id") @db.VarChar(100)
  payload    Json?
  ipAddress  String?     @map("ip_address") @db.VarChar(45)
  userAgent  String?     @map("user_agent") @db.VarChar(255)
  createdAt  DateTime    @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}
